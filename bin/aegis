#!/usr/bin/env bash
# aegis - run the AEGIS-LOOP CLI from anywhere.
# Resolves the repo root from this script's own path (following symlinks),
# pins AEGIS_LOOP_ROOT so configs/data resolve correctly from any cwd, and
# execs the repo venv's entry point with all arguments.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

export AEGIS_LOOP_ROOT="$REPO_ROOT"
exec "$REPO_ROOT/.venv/bin/aegis-loop" "$@"
